# Nest API port (listen on all interfaces for LAN / physical devices)
PORT=3000

# OpenAI-compatible chat API base URL (no trailing slash required).
# Local Ollama default:
CHAT_API_BASE_URL=http://127.0.0.1:11434

# Model name for POST /v1/chat/completions (must exist in Ollama: ollama pull <name>)
CHAT_MODEL=glm-4.7-flash

# Optional: Bearer token if your provider requires it (local Ollama usually leaves this unset)
# CHAT_API_KEY=
